local ORDER_S2={"Puzzle1","Puzzle3","Puzzle4","Puzzle2","CrystalBallWish"}
local LABEL_S1={Basketball="Basketball",PopTheBalloon="Balloon Dart",DunkBooth="Dunk Ball",MiniGolf="MiniGolf",["High Striker"]="High Striker",RingToss="Ring Toss",WhackAClown="Whack a Clown"}
