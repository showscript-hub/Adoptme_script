runners.Puzzle2 = function(_,ctl)
    local obj=waitForPuzzle("Puzzle2",20) if not obj then return end
    tp(POS.Puzzle2) task.wait(CFG.TeleportWait)
    local mirrors=obj:WaitForChild("Mirrors",10) local statues=obj:WaitForChild("EyeStatues",10)
    if not mirrors or not statues then return end
    local hollow=(WS:GetAttribute("MimicEvent")=="TheHollow") local map=hollow and {4,3,2,1} or {1,2,3,4}
    local seq,lastT,conns,flipped={},0,{},{}
    local state={Recording=true}
    for i=1,4 do
        local m=mirrors:FindFirstChild("Mirror"..i) local eye=m and m:FindFirstChild("Eye") local part=eye and eye:FindFirstChild("Part")
        if part then
            flipped[i]=part.Transparency<0.5
            table.insert(conns,part:GetPropertyChangedSignal("Transparency"):Connect(function()
                if not state.Recording then return end
                local vis=part.Transparency<0.5
                if vis and not flipped[i] then local now=os.clock() if now-lastT>CFG.EyeDebounce then lastT=now table.insert(seq,i) end end
                flipped[i]=vis
            end))
        end
    end
    local t0=os.clock() local lastCount=0
    while state.Recording and ctl.Running and os.clock()-t0<15 do
        if #seq~=lastCount then lastCount=#seq t0=os.clock() end
        if #seq>0 and os.clock()-t0>2 then break end
        task.wait(0.1)
    end
    state.Recording=false
    for _,c in ipairs(conns) do c:Disconnect() end
    if CFG.EyeBrute or #seq==0 then
        for _,order in ipairs({{1,2,3,4},{4,3,2,1}}) do
            for _,i in ipairs(order) do
                if not ctl.Running or obj:GetAttribute("Complete")==true then break end
                local e=statues:FindFirstChild("Eye"..i) firePrompt(promptOf(e)) task.wait(0.6)
            end
            if obj:GetAttribute("Complete")==true then break end
        end
        return
    end
    for _,i in ipairs(seq) do
        if not ctl.Running or obj:GetAttribute("Complete")==true then break end
        local e=statues:FindFirstChild("Eye"..map[i]) firePrompt(promptOf(e)) task.wait(0.6)
    end
end

